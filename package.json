{
  "name": "todo-telegram-mini-app",
  "version": "0.1.0",
  "description": "Простой и быстрый ToDo для мобильных устройств с поддержкой Telegram",
  "main": "index.html",
  "scripts": {
    "start": "python -m http.server 8000",
    "deploy": "powershell -ExecutionPolicy Bypass -File ./deploy/deploy.ps1",
    "server:dev": "node ./server/src/index.js",
    "server:migrate": "node ./server/src/migrate.js"
  },
  "keywords": [
    "todo",
    "telegram",
    "mini-app",
    "pwa",
    "productivity"
  ],
  "author": "TchernoffKA",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TchernoffKA/todo-telegram-mini-app.git"
  },
  "bugs": {
    "url": "https://github.com/TchernoffKA/todo-telegram-mini-app/issues"
  },
  "homepage": "https://github.com/TchernoffKA/todo-telegram-mini-app#readme",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "mysql2": "^3.15.1"
  }
}
